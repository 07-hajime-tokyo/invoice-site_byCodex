age/png,image/jpeg,image/gif,image/webp" class="hidden"/></div><div class="grid grid-cols-2 gap-3"><div><label class="text-xs">名前</label><input placeholder="例: 村上 肥" class="h-8 text-sm mt-1" value=""/></div><div><label class="text-xs">会社名</label><input placeholder="例: Murakami Trading" class="h-8 text-sm mt-1" value=""/></div></div><div class="grid grid-cols-2 gap-3"><div><label class="text-xs">メール</label><input placeholder="example@email.com" class="h-8 text-sm mt-1" value=""/></div><div><label class="text-xs">電話</label><input placeholder="+81 ..." class="h-8 text-sm mt-1" value=""/></div></div><div><label class="text-xs">住所</label><input placeholder="Street, Number" class="h-8 text-sm mt-1" value=""/></div><div class="grid grid-cols-2 gap-3"><div><label class="text-xs">都市</label><input placeholder="Tokyo" class="h-8 text-sm mt-1" value=""/></div><div><label class="text-xs">国</label><input placeholder="Japan" class="h-8 text-sm mt-1" value=""/></div></div><div><label class="text-xs">追加情報 <span class="text-muted-foreground font-normal">(税関番号・登録番号など)</span></label><textarea placeholder="例: 税関登録番号: EORI-12345
